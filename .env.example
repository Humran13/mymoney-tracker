# Copy this file to .env and fill in real values before running Docker Compose.
# Never commit the real .env file.

# --- Django ---
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
DJANGO_TIME_ZONE=Africa/Kampala

# --- Market / currency (v1: Uganda / UGX, but configurable) ---
DEFAULT_CURRENCY_CODE=UGX
DEFAULT_COUNTRY_CODE=UG

# --- Registration ---
ALLOW_PUBLIC_REGISTRATION=true

# --- Database (used by the db container; DATABASE_URL is assembled from these in compose.yaml) ---
POSTGRES_DB=mymoney
POSTGRES_USER=mymoney
POSTGRES_PASSWORD=change-this-strong-password

# --- Persistent storage paths (bind mounts — see docs/CLOUDPANEL.md) ---
# Defaults (./data/postgres, ./backups, ./private_media) are fine for a
# standalone deploy. On a CloudPanel VPS, point these at paths under that
# site user's own home directory instead, e.g.:
#   POSTGRES_DATA_DIR=/home/mymoney-site/mymoney-tracker/data/postgres
#   POSTGRES_BACKUP_DIR=/home/mymoney-site/mymoney-tracker/backups/postgres
#   PRIVATE_MEDIA_DIR=/home/mymoney-site/mymoney-tracker/private_media
POSTGRES_DATA_DIR=./data/postgres
POSTGRES_BACKUP_DIR=./backups
PRIVATE_MEDIA_DIR=./private_media

# --- CloudPanel deployment layout (informational — used by the example
# commands in docs/CLOUDPANEL.md, not read by Django or Docker Compose
# directly; fill these in to keep your own deployment commands consistent) ---
CLOUDPANEL_SITE_USER=
CLOUDPANEL_SITE_HOME=
APP_DEPLOY_DIR=

# --- Reverse proxy / HTTPS ---
# Standalone deployment (docker compose --profile standalone up -d): set
# this to your real domain so Caddy can obtain a Let's Encrypt certificate
# automatically. CloudPanel deployment: leave as-is — CloudPanel's own
# reverse proxy and certificate management handle this instead, and the
# app is reached internally via APP_PORT (see below).
DOMAIN=localhost
SECURE_SSL_REDIRECT=true

# Only used for a CloudPanel deployment, where CloudPanel's reverse proxy
# forwards to the app over 127.0.0.1 at this port (see docs/CLOUDPANEL.md).
APP_PORT=8001

# --- Email (password reset, future notifications) ---
# Leave SMTP_HOST empty to keep using the console backend (emails are just
# logged, nothing is sent) — fine for local testing with colleagues before
# you have a real provider. Fill these in for actual delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
DEFAULT_FROM_EMAIL=MyMoney Tracker <noreply@yourdomain.com>
